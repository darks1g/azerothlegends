+++ b/backend/src/main/resources/application.properties
@@ -0,0 +1,11 @@
+# Perfil por defecto: dev (H2 local, sin instalar nada). Para MySQL: SPRING_PROFILES_ACTIVE=prod
+spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}
+
+# Credenciales de Blizzard: SIEMPRE por variables de entorno, nunca en el repo
+blizzard.client-id=${BLIZZARD_CLIENT_ID}
+blizzard.client-secret=${BLIZZARD_CLIENT_SECRET}
+blizzard.region=${BLIZZARD_REGION:eu}
+blizzard.redirect-uri=${BLIZZARD_REDIRECT_URI:http://localhost:8080/oauth/callback}
+
+spring.jpa.hibernate.ddl-auto=update
+spring.jpa.show-sql=false
